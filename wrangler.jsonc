{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-mail2tg-aibot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "MAIL_ROUTES_KV"
      // Cloudflare 1-Click Web Deploy automatically creates and binds this KV namespace.
      // CLI manual deployment: execute `npx wrangler kv namespace create MAIL_ROUTES_KV` and optionally append "id": "<YOUR_ID>".
    }
  ],
  "vars": {
    // Delivery & Alias Settings (Optional: Set in secrets or here)
    "ENABLE_GMAIL_ALIASES": "false",
    
    // Security Armor: Block all attachments by default (Zero-Attachment Policy SMTP 550)
    "BLOCK_ALL_ATTACHMENTS": "true",
    
    // Size Cap: Reject emails larger than 5MB (SMTP 552) to prevent memory & quota exhaustion
    "MAX_EMAIL_SIZE_BYTES": "5242880",
    
    // Default AI Provider: 'workers-ai' (Free, Zero-Key, Native Edge AI)
    "AI_PROVIDER": "workers-ai",
    
    // Default system language: 'zh-CN' | 'en-US' | 'zh-TW' | 'ja-JP' | 'ko-KR' | 'pt-BR' | 'ru-RU' | 'es-ES' | 'fr-FR' | 'de-DE'
    "DEFAULT_LANGUAGE": "zh-CN"
  }
}
