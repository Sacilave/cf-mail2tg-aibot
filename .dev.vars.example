# =============================================================================
# cf-mail2tg-aibot Local & Production Environment Variables Template
# Copy this file to `.dev.vars` for local development.
# For production, set via `npx wrangler secret put <KEY>` or GitHub Action Secrets.
# =============================================================================

# [REQUIRED] Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# [REQUIRED] Telegram Admin Chat ID obtained from @userinfobot (authorized user ID)
TELEGRAM_ADMIN_CHAT_ID="123456789"

# [RECOMMENDED] Webhook Secret Token for cryptographic request authentication
# Protects your Worker from spoofed Telegram webhook requests (1-256 chars, A-Za-z0-9_-)
TELEGRAM_WEBHOOK_SECRET=""

# [OPTIONAL] Backup email address for Zero-Drop guarantee (e.g. Gmail)
# Must be verified in Cloudflare Email Routing -> Destination addresses first.
# If omitted, gateway operates in single-track mode (Telegram instant notifications only).
FORWARD_TO_EMAIL="your-backup-email@gmail.com"

# [OPTIONAL] Whether to enable product persona Gmail aliases (e.g. your-email+personal@gmail.com)
ENABLE_GMAIL_ALIASES="false"

# [OPTIONAL] Block all attachments with SMTP 550 reject (Zero-Attachment Policy, default: true)
BLOCK_ALL_ATTACHMENTS="true"

# [OPTIONAL] Maximum email size in bytes before SMTP 552 rejection (default: 5MB = 5242880)
MAX_EMAIL_SIZE_BYTES="5242880"

# [OPTIONAL] Telegram marketing notification policy: 'silent' (no vibration/sound) | 'mute' (do not send to TG)
MARKETING_TG_POLICY="silent"

# [OPTIONAL] Default display language ('zh-CN' | 'en-US' | 'zh-TW' | 'ja-JP' | 'ko-KR' | 'pt-BR' | 'ru-RU' | 'es-ES' | 'fr-FR' | 'de-DE', default: zh-CN)
DEFAULT_LANGUAGE="en-US"

# [OPTIONAL] Multi-Provider AI Triage & Verification Code Extraction Settings
# Supported providers: workers-ai | deepseek | groq | openai | gemini | claude | openrouter | minimax | custom
# Note: workers-ai runs natively on Cloudflare Workers edge without any external API Key (100% Free)!
AI_PROVIDER="deepseek"
AI_API_KEY=""
AI_MODEL="deepseek-chat"
AI_BASE_URL=""

# [OPTIONAL] Provider-specific API Keys (for auto-detection if AI_PROVIDER is omitted)
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""

# [OPTIONAL - BACKWARD COMPATIBILITY] MiniMax Legacy Config
MINIMAX_API_KEY=""
MINIMAX_GROUP_ID=""
MINIMAX_MODEL="MiniMax-Text-01"
MINIMAX_API_URL="https://api.minimax.chat/v1/text/chatcompletion_v2"

# [OPTIONAL] Resend API Key for sending and replying to emails (starts with re_)
# Can also be set interactively inside Telegram via `/setkey resend re_xxxxxx`
RESEND_API_KEY=""

# [OPTIONAL] Primary verified sender domain in Resend & Cloudflare (e.g. yourdomain.com)
EMAIL_DOMAIN="example.com"
